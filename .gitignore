# ESP-IDF build output
/build/
sdkconfig
sdkconfig.old
managed_components/
dependencies.lock

# Host test artifacts
/test/host/test_pharos
/test/host/*.dSYM/
*.o
*.gcda
*.gcno

# Editor / OS
.DS_Store
.vscode/
.idea/
*.swp
compile_commands.json

# Renderer binary (the PNGs it writes are committed)
/tools/render/pharos_render
/tools/render/*.dSYM/

# Python bytecode from the host-side tools. tools/screen/grab.py is imported
# as a module by sweep.py, so running the sweep leaves a __pycache__ behind -
# and one of those was committed.
__pycache__/
*.py[cod]
# Built harnesses. Listed by name once and then by pattern, because the
# second binary was added without a rule and got committed - CI then tried
# to execute an arm64 Mach-O on Linux and reported it as a shell syntax
# error, which says nothing about the cause.
/test/fuzz/fuzz
/test/fuzz/fuzz_state
/test/fuzz/*.dSYM/

# Session scratch from the agent harness - worktrees, transcripts, scripts.
# `git add -A` swept twelve of these into a commit once; they are embedded git
# repositories, so they land as bare gitlinks that clone to nothing.
/.claude/
